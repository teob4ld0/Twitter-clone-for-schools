{
  "ConnectionStrings": {
    "DefaultConnection": "server=YOUR_DB_HOST;port=3306;database=YOUR_DB_NAME;user=YOUR_DB_USER;password=YOUR_DB_PASSWORD"
  },
  
  "Jwt": {
    "Key": "YOUR_JWT_SECRET_KEY_AT_LEAST_32_CHARS",
    "Issuer": "MyNetApp",
    "Audience": "MyNetAppUsers",
    "ExpiresMinutes": 90
  },

  "GoogleCloudStorage": {
    "BucketName": "your-bucket-name",
    "PublicBaseUrl": "https://your-cdn-url.com",
    "DefaultPrefix": "media",
    "GoogleCredentialsJson": "",
    "TrySetPublicReadAcl": false
  },

  "GoogleAuth": {
    "ClientId": "YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com",
    "ClientSecret": "YOUR_GOOGLE_CLIENT_SECRET",
    "RedirectUri": "https://your-domain.com/api/auth/google/exchange",
    "FrontendUrl": "https://your-frontend.com",
    "MobileScheme": "mynetapp",
    "AllowedEmailDomains": ["yourdomain.com"]
  },

  "Brevo": {
    "ApiKey": "YOUR_BREVO_API_KEY",
    "SenderEmail": "support@yourdomain.com",
    "SenderName": "YourApp",
    "FrontendUrl": "https://your-frontend.com",
    "VerificationEmailTemplateId": 2,
    "WelcomeEmailTemplateId": null,
    "PasswordResetTemplateId": null
  },

  "VapidKeys": {
    "PublicKey": "YOUR_VAPID_PUBLIC_KEY",
    "PrivateKey": "YOUR_VAPID_PRIVATE_KEY",
    "Subject": "mailto:admin@yourdomain.com"
  },

  "Firebase": {
    "ProjectId": "your-firebase-project-id",
    "ServiceAccountFilePath": "firebase-service-account.json"
  }
}
